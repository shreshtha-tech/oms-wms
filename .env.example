# ------------------------------------------------------------------
# D-Mills Global Private Limited environment variables
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# ------------------------------------------------------------------

# --- MongoDB connection (server-side) ---
# Get this from MongoDB Atlas: Connect -> Drivers -> copy the URI.
# If left blank, the app uses an empty in-memory store. Data is lost on restart.
MONGODB_URI=
# Explicit database selection overrides any database path in MONGODB_URI.
# Choose local and Render values deliberately; production requires this key.
MONGODB_DB=d_mills_global
# Set true in production hosts so startup refuses ephemeral in-memory storage.
DMILLS_REQUIRE_PERSISTENCE=false

# Set both values to enable server-verified login.
# Generate the password hash with: node scripts/hash-admin-password.mjs
DMILLS_ADMIN_USER=
DMILLS_ADMIN_PASSWORD_HASH=
# --- Port the Express server listens on (Render sets PORT automatically) ---
PORT=3002

# Add integration credentials only when a real connector is configured.
# Do not commit credentials to source control.

# Isolated PostgreSQL central inventory subsystem (see docs/CENTRAL_INVENTORY_IMPLEMENTATION.md).
# No stock is migrated from MongoDB automatically.
INVENTORY_DATABASE_URL=
# Public HTTPS origin registered as the OAuth callback and webhook host (no path).
INVENTORY_PUBLIC_ORIGIN=
# SP-API application identifier used by Seller Central consent (not an IAM ARN).
AMAZON_SP_API_APPLICATION_ID=
INVENTORY_CREDENTIAL_KEY=
INVENTORY_ALLOWED_TENANT_ID=
INVENTORY_SHOPIFY_DOMAIN=
# New Shopify apps use Dev Dashboard client credentials. Keep these private.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
AMAZON_INVENTORY_SQS_URL=
AMAZON_INVENTORY_ACCOUNT_ID=

# Meta WhatsApp Cloud API. Configure approved utility templates with four body
# variables. New order: platform, order ID, SKU summary, "Check stock in D-Mills".
# Optional packing alert: platform, order ID, SKU summary, packing deadline.
# Keep these server-side; the ordinary WhatsApp Business phone app is insufficient.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_PACKING_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Approved Meta AUTHENTICATION template with COPY_CODE OTP button.
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US
# Enable only behind exactly one trusted proxy (Render). Local default is false.
TRUST_PROXY=false
