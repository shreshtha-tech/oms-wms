  "handlers": {
    "callSearch": "function callSearch() {\n\n\t\t$(\"#languageSearchGrid\").jqGrid('setGridParam', {\n\t\t\tdatatype : 'json',\n\t\t\tpage : 1\n\t\t});\n\t\t$(\"#languageSearchGrid\").jqGrid('setGridParam', {\n\t\t\tpostData : {\n\t\t\t\tlanguageId : $(\"#language\").val(),\n\t\t\t\tpropertyType : $(\"#propertyType\").val(),\n\t\t\t\tpropertyKey : $(\"#propertyKey\").val(),\n\t\t\t\tpropertyValue : $(\"#propertyValue\").val(),\n\t\t\t\tREQ_SEARCH_FLAG : true\n\t\t\t},\n\t\t\turl : \"fetchLanguageProperties\",\n\t\t\tsearch : true\n\t\t}).trigger('reloadGrid');\n\t}",
    "resetData": "function resetData(){\n\t\t$(\"#propertyType\").val(\"-1\");\n\t\t$(\"#propertyKey\").val(\"\");\n\t\t$(\"#propertyValue\").val(\"\");\n\t\t\n\t\t$(\"#jqgh_languageSearchGrid_langValue\").html($(\"#language option:selected\").text());\n\n\t\t$(\"#languageSearchGrid\").jqGrid('clearGridData', {\n\t\t\tclearfooter : true\n\t\t});\n\t}",
    "clickSave": "function clickSave() {\n\t\t\n\t\tif (trimString($(\"#overrideValue\").val()).toUpperCase() == trimString($(\"#defaultValue1\").html()).toUpperCase()) {\n\t\t\ttryFocusBS($(\"#overrideValue\"));\n\t\t\twindow.parent.showAlert(\"Overrided Text is should not be same as Default Text\"); \n\t\t\treturn false;\n\t\t}\n\t\t\n\t\tvar retVal = $.ajax({\n\t\t\turl: \"EditPropertyValueBS\",\n\t\t\tglobal: false,\n\t\t\ttype: \"POST\",\n\t\t\tdata: {\n\t\t\t\tpropertyKey : $(\"#propertyKey1\").html(),\n\t\t\t\toverrideValue: $(\"#overrideValue\").val(),\n\t\t\t\tlanguageId1 : $(\"#editLangId\").val(),\n\t\t\t\tisMobile : $(\"#isMobile\").val()\n\t\t\t},\n\t\t\tdataType: \"json\",\n\t\t\tasync: false\n\t\t\t}).responseText;\n\t\tretVal = jQuery.parseJSON(retVal);\n\t\t\n\t\tif(retVal!=null) {\n\t\t\tif(retVal.jsonMessage==null) {\n\t\t\t\tif(retVal.langPropertyMap!=null) {\n\t\t\t\t\tvar gridObj = $('#languageSearchGrid');\n\t\t\t\t\tvar index =gridObj.jqGrid('getInd', $(\"#editRowId\").val());\n\t\t\t\t\tvar position = 'first';\n\t\t\t\t\tvar srcRowId='';\n\t\t\t\t    if ( index == 1 ) {\n\t\t\t\t\t\tposition = 'first';\n\t\t\t\t\t} else {\n\t\t\t\t    \tposition = 'after';\n\t\t\t\t        srcRowId = gridObj.find('tr#' + $(\"#editRowId\").val()).prev()[0].id;\n\t\t\t\t    }\n\t\t\t\t\t \n\t\t\t\t    gridObj.jqGrid('delRowData', $(\"#editRowId\").val());\n\t\t\t\t    gridObj.jqGrid('addRowData', $(\"#editRowId\").val(), retVal.langPropertyMap[0], position, srcRowId);\n//\t\t\t\t\t$('#languageSearchGrid').jqGrid('setRowData', $(\"#editRowId\").val(), retVal.langPropertyMap[0]);\n\t\t\t\t}\n\t\t\t\t\n\t\t\t\t$(\"#EditDialog\").modal('hide')\n\t\t\t\t\n\t\t\t\twindow.parent.showAlert(retVal.langDTO.createDateText); \n\t\t\t\treturn false;\n\t\t\t} else {\n\t\t\t\twindow.parent.showAlert(retVal.jsonMessage); \n\t\t\t\treturn false;\n\t\t\t}\n\t\t}\n\t\t\n\t\t\n\t}",
    "closePickList": "function closePickList() {\n\t\t\t$(\"#pickListIFrame\").removeAttr(\"src\");\n\t\t\t$(\"#pickListDialog\").modal('hide');\n\t\t}",
    "okPickList": "function okPickList() {\n\t\t\twindow.pickListIFrame.okClick();\n\t\t}"
  }
