    "doExport": "function doExport() {\n\t\tif ($(\"#fromLogDate\").val() == \"\") {\n\t\t\twindow.parent.showAlert('Please fill all mandatory fields');\n\t\t\t$(\"#fromLogDate\").focus();\n\t\t\tevent.preventDefault();\n\t\t\treturn false;\n\t\t}\n\t\tif ($(\"#toLogDate\").val() == \"\") {\n\t\t\twindow.parent.showAlert('Please fill all mandatory fields');\n\t\t\t$(\"#toLogDate\").focus();\n\t\t\tevent.preventDefault();\n\t\t\treturn false;\n\t\t}\n\t\tif ($(\"#log\").val() == \"-1\") {\n\t\t\twindow.parent.showAlert('Please fill all mandatory fields');\n\t\t\t$(\"#log\").focus();\n\t\t\tevent.preventDefault();\n\t\t\treturn false;\n\t\t}\n\t\tvar date = new Date();\n\t\tvar curr_date = date.getDate();\n\t\tvar curr_month = date.getMonth();\n\t\tcurr_month = curr_month + 1;\n\t\tvar curr_year = date.getFullYear();\n\t\tvar today_date = new Date(curr_year + '/' + curr_month + '/'\n\t\t\t\t+ curr_date);\n\t\tvar startdatevalue = $(\"#fromLogDate\").val();\n\t\tvar enddatevalue = $(\"#toLogDate\").val();\n\t\tvar log = $(\"#log\").val();\n\t\tvar inputDate = startdatevalue.split('/');\n\t\tvar startdate = new Date(inputDate[2] + '/' + inputDate[1] + '/'\n\t\t\t\t+ inputDate[0]);\n\t\tvar inputDate2 = enddatevalue.split('/');\n\t\tvar enddate = new Date(inputDate2[2] + '/' + inputDate2[1] + '/'\n\t\t\t\t+ inputDate2[0]);\n\t\tif (inputDate2[2] > inputDate[2]) {\n\t\t\tif (inputDate2[1] > inputDate[1]) {\n\t\t\t\talert(\"Date Range Should Be an Year \");\n\t\t\t\treturn false;\n\t\t\t}\n\t\t\tif (inputDate2[1] == inputDate[1])\n\t\t\t\tif (inputDate2[0] > inputDate[0]) {\n\t\t\t\t\talert(\"Date Range Should Be an Year \");\n\t\t\t\t\treturn false;\n\t\t\t\t}\n\n\t\t}\n\t\tif (startdate > enddate) {\n\t\t\twindow.parent.showAlert('From date should be greater than To date');\n\t\t\t$(\"#toLogDate\").focus();\n\t\t\treturn false;\n\t\t} else if (startdate > today_date) {\n\t\t\twindow.parent.showAlert('From date should be greater than today');\n\t\t\t$(\"#fromLogDate\").focus();\n\t\t\treturn false;\n\t\t} else if (enddate > today_date) {\n\t\t\twindow.parent.showAlert('To date should be greater than today');\n\t\t\t$(\"#toLogDate\").focus();\n\t\t\treturn false;\n\t\t}\n\t\tvar fromLogDate = $(\"#fromLogDate\").val();\n\t\tvar toLogDate = $(\"#toLogDate\").val();\n\n\t\tvar retVal = $.ajax({\n\t\t\ttype: \"POST\",\n            url: \"generateUserAuditLogExport\",\n            data : {\n            \tfromDate : fromLogDate,\n            \ttoDate : toLogDate,\n            \tlogType : log\n    \t\t},\n            success: function(data) {\n                if(data.jsonMessage == null) {\n            \t    window.parent.pendingReportSearch('?uuId='+data.reportId);\n                } else {\n            \t    window.parent.showAlert(data.jsonMessage);\n            \t    window.parent.pendingReportSearch();\n                }\n            }\n\t\t});\n\t}",
    "resetAll": "function resetAll()\n{\n\tdocument.userAuditLogsForm.action = \"roleLogBS\";\n\tdocument.userAuditLogsForm.submit();\n}"
