  "handlers": {
    "openConfiguration": "function openConfiguration(thisObj, slectedSeqId) {\n\t\t\t\n\t\t\n\t\t\tif (slectedSeqId != undefined) {\n\t\t\t\twindow.parent.openScreen(\"Manage Api Add/Edit\", 'manageApiKeyEdit?seqId='+slectedSeqId, \"fa fa-fw fa-list-ol\");\n\t\t\t\treturn false;\t\n\t\t\t} else {\n\t\t\t\twindow.parent.showAlert('Something Went Wrong');\n\t\t\t\treturn false;\n\t\t\t}\n\t\t}",
    "refreshConfiguration": "function refreshConfiguration(event){\n\t\t\treloadSearchGrid(event);\n\t\t}",
    "openWhConfiguration": "function openWhConfiguration() {\n\t\t\twindow.parent.openScreen(\"Register Webhook\", 'manageApiWebhook', \"fa fa-fw fa-list-ol\");\n\t\t\treturn false;\t\t\t\n\t\t}",
    "changeStatus": "function changeStatus(seqId, clientId, status){\n\n\t\t\tif(seqId == undefined || status == undefined || (clientId == undefined && false)){\n\t\t\t\twindow.parent.showAlert('Something Went Wrong');\n\t\t\t\treturn false;\n\t\t\t} \n\t\t\telse if(status == 0){\n\t\t\t\t\n\t\t\t\tif (confirm(\"Do You Want To Activate this API?\")) {\n\t\t\t\t\tvar statusResponse = $.ajax({\n\t\t\t\t\t\turl : \"generateApiKey?seqId=\"+seqId+\"&clientId=\"+clientId,\n\t\t\t\t\t\t\n\t\t\t\t\t\ttype : \"POST\",\n\t\t\t\t\t\tdataType : \"json\",\n\t\t\t\t\t\tasync : false\n\t\t\t\t\t}).responseText;\n\t\n\t\t\t\t\tstatusResponse = jQuery.parseJSON(statusResponse);\n\t\t\t\n\t\t\t\t\tif (statusResponse.status) {\n\t\t\t\t\t\treloadSearchGrid();\n\t\t\t\t\t\twindow.parent.showAlert(statusResponse.jsonMessage);\n\t\t\t\n\t\t\t\t\t} else {\n\t\t\t\t\t\t$(\"#apikey\").html(\"\");\n\t\t\t\t\t\twindow.parent.showAlert(statusResponse.jsonMessage);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\telse if(status == 1){\n\t\t\t\tif (confirm(\"admin.deapiactivate\")) {\n\t\t\t\t\tvar statusResponse = $.ajax({\n\t\t\t\t\t\turl : \"deactivateApiKey?seqId=\"+seqId+\"&clientId=\"+clientId,\n\t\t\t\t\t\t\n\t\t\t\t\t\ttype : \"POST\",\n\t\t\t\t\t\tdataType : \"json\",\n\t\t\t\t\t\tasync : false\n\t\t\t\t\t}).responseText;\n\t\n\t\t\t\t\tstatusResponse = jQuery.parseJSON(statusResponse);\n\t\n\t\t\t\t\tif (statusResponse.status) {\n\t\t\t\t\t\treloadSearchGrid();\n\t\t\t\t\t\twindow.parent.showAlert(statusResponse.jsonMessage);\n\t\t\t\t\t} else {\n\t\t\t\t\t\t$(\"#apikey\").html(\"\");\n\t\t\t\t\t\twindow.parent.showAlert(statusResponse.jsonMessage);\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\t\t\n\t\t}"
